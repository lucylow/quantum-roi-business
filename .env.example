# Optional mobile API endpoint.
# Production builds should use HTTPS; omit this variable to keep local-first mode.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Optional metadata used by the app config and release checks.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
EXPO_PUBLIC_SUPPORT_URL=https://example.com/support
APP_ENV=production
EXPO_PUBLIC_APP_ENV=production
